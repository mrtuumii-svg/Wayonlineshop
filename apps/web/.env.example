# Энэ файлыг `.env.local` нэрээр хуулж, QPay-ээс авсан merchant мэдээллээ бөглөнө.
# `.env.local` нь git-д орохгүй. QPAY_* утгууд зөвхөн dev серверт уншигдана, браузерт очихгүй.
# QPAY_CLIENT_ID хоосон бол QPay-ийн sandbox (туршилтын) горимд ажиллана.

QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
# QPAY_BASE_URL=https://merchant.qpay.mn
# QPAY_CALLBACK_URL=https://таны-домэйн.mn/api/qpay/callback

# 'mock' болговол QPay руу огт хандахгүй (e2e тест)
# VITE_PAYMENT_MODE=qpay

# Backend-тэй ажиллах: VITE_API_MODE=http. VITE_API_URL хоосон бол `/api` → API_PROXY_TARGET (dev proxy)
# VITE_API_MODE=http
# VITE_API_URL=https://api.таны-домэйн.mn
# API_PROXY_TARGET=http://localhost:3000
