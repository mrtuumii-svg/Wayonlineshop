# Way Academy API — орчны хувьсагчид.
# Хуулж `.env` болгон өөрийн утгуудаа тавина. `.env` нь git-д ХЭЗЭЭ Ч орохгүй.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# docker-compose.yml дээрх dev сантай тохирно
DATABASE_URL=postgresql://way:way_dev_only@localhost:5432/way_dev

# Дор хаяж 32 тэмдэгт. Production-д санамсаргүй үүсгэнэ:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-value-min32

# Frontend-ийн хаяг. Хэд хэдэн бол таслалаар зааглана.
CORS_ORIGIN=http://localhost:5173

# Төлбөр. Одоогоор зөвхөн fake (production-д хориотой — сервер эхлэхгүй).
PAYMENT_PROVIDER=fake
# Webhook-ийн гарын үсгийн түлхүүр, дор хаяж 32 тэмдэгт. JWT_SECRET-ээс өөр байна.
PAYMENT_WEBHOOK_SECRET=change-me-to-another-long-random-value
# Fake: нэхэмжлэх үүсгэснээс хойш хэдэн ms-ийн дараа автоматаар "төлөгдөх". 0 = гараар.
FAKE_PAY_AFTER_MS=2000
