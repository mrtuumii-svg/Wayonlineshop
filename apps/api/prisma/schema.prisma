// Way Academy — өгөгдлийн схем.
// Үнэ бүхэлдээ төгрөгөөр (Int). Эрхийг Order-оор бус Enrollment-ээр шалгана.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String           @id @default(uuid())
  name         String
  /// Хадгалахаас өмнө trim().toLowerCase() хийгдэнэ
  email        String           @unique
  passwordHash String
  /// admin эрхийг зөвхөн `npm run make-admin` скриптээр өгнө — API-аар хэзээ ч
  role         Role             @default(user)
  createdAt    DateTime         @default(now())
  orders       Order[]
  enrollments  Enrollment[]
  progress     LessonProgress[]
}

model Instructor {
  id      String   @id @default(uuid())
  name    String
  avatar  String
  bio     String
  courses Course[]
}

model Course {
  id           String       @id @default(uuid())
  slug         String       @unique
  title        String
  description  String
  /// Төгрөгөөр, бүхэл тоо
  price        Int
  thumbnail    String
  category     String
  level        Level
  instructorId String
  instructor   Instructor   @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  sections     Section[]
  orderItems   OrderItem[]
  enrollments  Enrollment[]
  books        Book[]

  @@index([category, level])
  @@index([instructorId])
}

model Section {
  id       String   @id @default(uuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order    Int
  title    String
  lessons  Lesson[]

  @@unique([courseId, order])
}

model Lesson {
  id          String           @id @default(uuid())
  sectionId   String
  section     Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  durationSec Int
  isPreview   Boolean          @default(false)
  /// YouTube-ийн 11 тэмдэгтийн ID (бүтэн URL биш). Эзэмшээгүй хэрэглэгчид хэзээ ч буцаахгүй.
  youtubeId   String           @db.VarChar(11)
  progress    LessonProgress[]

  @@unique([sectionId, order])
}

model Order {
  id                String       @id @default(uuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// Төгрөгөөр — серверт үнээс тооцоологдоно, клиентийн утгад итгэхгүй
  total             Int
  status            OrderStatus  @default(pending)
  provider          String
  providerInvoiceId String?      @unique
  createdAt         DateTime     @default(now())
  items             OrderItem[]
  enrollments       Enrollment[]

  @@index([userId, createdAt])
}

model OrderItem {
  id              String @id @default(uuid())
  orderId         String
  order           Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  /// Худалдан авах үеийн үнийг хөлдөөнө — дараа үнэ өөрчлөгдсөн ч түүх зөв
  priceAtPurchase Int

  @@unique([orderId, courseId])
  @@index([courseId])
}

/// Эрхийн цорын ганц үнэн. Дараа нь бэлэг/купон/админ эрх ч энд л бичигдэнэ.
model Enrollment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([orderId])
}

model LessonProgress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([lessonId])
}

/// AI туслахтай хийсэн нэг яриа. Нэвтрэлт шаардахгүй — клиент id-г localStorage-д хадгална.
model Conversation {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  messages  Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  /// Яриа устахад мессежүүд нь хамт устана — яриагүй мессеж утгагүй
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatRole
  content        String
  /// Зөвхөн assistant-д: тэр дуудлагын token (snapshot — дараа үнэ өөрчлөгдсөн ч зардлыг тооцож болно)
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/// Telemetry (13-р хичээл): model-ийн дуудлага БҮРТ нэг мөр — амжилттай ч, алдаатай ч.
/// Мессежийн текст энд ОРОХГҮЙ (хувийн мэдээлэл) — хэрэгтэй бол conversationId-аар Message-ээс харна.
model LlmCall {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())
  /// FK биш: яриа устсан ч зардлын түүх үлдэнэ. Алдаатай шинэ ярианд null
  conversationId String?
  /// Нэг хэрэглэгчийн мессежид хамаарах бүх дуудлагыг холбоно (agent loop-д олон мөр)
  traceId        String
  /// Тэр trace доторх хэддүгээр эргэлт (1-ээс)
  step           Int      @default(1)
  model          String
  /// Нийт input, cache-ээс уншсан нь орсон
  inputTokens    Int      @default(0)
  cachedTokens   Int      @default(0)
  outputTokens   Int      @default(0)
  /// Тухайн үеийн үнээр тооцсон snapshot — үнэ өөрчлөгдсөн ч хуучин мөр хэвээр
  costUsd        Decimal  @default(0) @db.Decimal(12, 8)
  durationMs     Int
  stopReason     String?
  /// Алдааны төрөл (жишээ нь LlmUnavailableError: HTTP 429). null = амжилттай
  error          String?

  @@index([createdAt])
  @@index([conversationId])
}

/// Үнэгүй ном. Манай сайт номыг хадгалахгүй — readUrl нь албан ёсны үнэгүй хувилбар руу хөтөлнө.
model Book {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  author      String
  description String
  /// Хичээлийн ангилалтай ижил (Програмчлал, Дизайн, ...)
  category    String
  language    String
  year        Int?
  /// Нүүр зураг. Байхгүй бол сайт гарчиг, зохиогчоор нь нүүр зурна
  coverUrl    String?
  readUrl     String
  /// Холбогдох хичээл. Хичээл устахад ном үлдэнэ, холбоос нь л арилна
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([courseId])
}

enum Role {
  user
  admin
}

enum Level {
  beginner
  intermediate
  advanced
}

enum OrderStatus {
  pending
  paid
  failed
}

enum ChatRole {
  user
  assistant
}
