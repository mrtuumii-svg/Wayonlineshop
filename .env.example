# `docker compose --profile app` (api контейнер)-д зориулсан нууцууд.
# Хуулж `.env` болгоно. `.env` нь git-д ХЭЗЭЭ Ч орохгүй.
# Санамсаргүй утга үүсгэх:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Дор хаяж 32 тэмдэгт
JWT_SECRET=
# Дор хаяж 32 тэмдэгт, JWT_SECRET-ээс өөр
PAYMENT_WEBHOOK_SECRET=

# Төлбөр: fake (анхдагч) эсвэл qpay. QPAY_* хоосон бол sandbox.
PAYMENT_PROVIDER=
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
# QPay callback-ийн суурь хаяг (https), жишээ нь https://api.таны-домэйн.mn
PUBLIC_API_URL=

# AI туслах (/chat) — заавал биш. Gemini key: https://aistudio.google.com
LLM_API_KEY=
